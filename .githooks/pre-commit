#!/bin/sh
# Scan the index, including on the first commit; never print secret values.
set -eu
root=$(git rev-parse --show-toplevel)
cd "$root"
IFS= read -r version < tools/gitleaks-release.txt
binary="$root/.tools/gitleaks/$version/gitleaks"
case "$(uname -s)" in
  MINGW*|MSYS*|CYGWIN*) binary="$binary.exe" ;;
esac
if [ ! -x "$binary" ]; then
  printf '%s\n' 'pre-commit: Gitleaks is missing. Run sh tools/setup-git-hooks.sh (macOS/Linux) or ./tools/setup-git-hooks.ps1 (Windows PowerShell).' >&2
  exit 1
fi
exec "$binary" git --pre-commit --staged --redact --no-banner
